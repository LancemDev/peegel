{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Peegel",
  "version": "0.1.0",
  "identifier": "dev.lancem.peegel",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Peegel",
        "width": 420,
        "height": 640,
        "minWidth": 360,
        "minHeight": 480,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "category": "Utility",
    "shortDescription": "Shared clipboard between Android and Linux",
    "longDescription": "Peegel syncs text and images between your Android phone and your computer over local Wi-Fi, end-to-end encrypted.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
